@model MVC.ViewModels.MenuItemViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <h2>Delete</h2>
    <h5>Are you sure you want to delete this?</h5>
    <dl class="row">
        <dt class="col-sm-3">ItemName</dt>
        <dd class="col-sm-9">@Model.ItemName</dd>
        <dt class="col-sm-3">ItemType</dt>
        <dd class="col-sm-9">@Model.ItemType</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdmenuItem" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
</div>