@model MVC.ViewModels.MenuItemViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <h2>Details</h2>
    <dl class="row">
        <dt class="col-sm-3">Item Name</dt>
        <dd class="col-sm-9">@Model.ItemName</dd>

        <dt class="col-sm-3">Item Type</dt>
        <dd class="col-sm-9">@Model.ItemType</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>

        @if (!string.IsNullOrEmpty(Model.ImageBase64))
        {
            <dt class="col-sm-3">Image</dt>
            <dd class="col-sm-9">
                <img src="@Model.ImageBase64" alt="Menu Item Image" style="max-height: 200px;" />
            </dd>
        }
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.IdmenuItem" class="btn btn-outline-primary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>
