@model MVC.ViewModels.MenuItemViewModel

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <h2>Edit MenuItem</h2>
    <form asp-action="Edit">
        <input type="hidden" asp-for="IdmenuItem" />

        <div class="mb-3">
            <label asp-for="ItemName" class="form-label"></label>
            <input asp-for="ItemName" class="form-control" />
            <span asp-validation-for="ItemName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ItemType" class="form-label"></label>
            <input asp-for="ItemType" class="form-control" />
            <span asp-validation-for="ItemType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VenueId" class="form-label"></label>
            <select asp-for="VenueId" asp-items="ViewBag.VenueList" class="form-select"></select>
            <span asp-validation-for="VenueId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
