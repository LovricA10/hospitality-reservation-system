@model MVC.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <h2>Details</h2>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">LastName</dt>
        <dd class="col-sm-9">@Model.LastName</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Iduser" class="btn btn-outline-primary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>