@model MVC.ViewModels.HospitalityTypeViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h2>Create Hospitality Type</h2>
    <form asp-action="Create">
        <div class="mb-3">
            <label asp-for="TypeName" class="form-label"></label>
            <input asp-for="TypeName" class="form-control" />
            <span asp-validation-for="TypeName" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
