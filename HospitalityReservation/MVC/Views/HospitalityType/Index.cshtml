@model IEnumerable<MVC.ViewModels.HospitalityTypeViewModel>

@{
    ViewData["Title"] = "Index";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" class="d-flex">
                <input type="text" name="q" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="Search text" />
                <select name="categoryId" class="form-select me-2">
                    <option value="">All Categories</option>
                </select>
                <button type="submit" class="btn btn-outline-secondary">Search</button>
            </form>
        </div>
        <div class="col-md-6 text-end">
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-primary">+ Add New</a>
            }
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>TypeName</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TypeName</td>
                    <td>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Idtype" class="btn btn-sm btn-outline-primary" title="Edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Idtype" class="btn btn-sm btn-outline-danger" title="Delete">Delete</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.Idtype" class="btn btn-sm btn-outline-info" title="Details">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            Show:
            <select onchange="location = this.value;" class="form-select d-inline w-auto">
                <option value="?size=10">10</option>
                <option value="?size=25">25</option>
                <option value="?size=50">50</option>
            </select>
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item"><a class="page-link" href="#">«</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">»</a></li>
            </ul>
        </nav>
    </div>
</div>
