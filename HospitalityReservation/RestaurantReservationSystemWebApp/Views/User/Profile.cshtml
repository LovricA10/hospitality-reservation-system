@model UserProfileVM
@{
    ViewData["Title"] = "Profile";
}

<div class="auth-container">
    <h2>My Profile</h2>

    <div id="ajaxMessage" class="alert d-none"></div>

    <form id="profileForm">
        <div class="mb-3">
            <label class="form-label">Email (readonly)</label>
            <input class="form-control" value="@Model.Email" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#profileForm').submit(function (e) {
                e.preventDefault();

                const model = {
                    FirstName: $('#FirstName').val(),
                    LastName: $('#LastName').val(),
                    Phone: $('#Phone').val(),
                    Password: $('#Password').val(),
                    ConfirmPassword: $('#ConfirmPassword').val()
                };

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Profile", "User")',
                    data: model,
                    success: function (response) {
                        $('#ajaxMessage')
                            .removeClass('d-none alert-danger')
                            .addClass('alert alert-success')
                            .text(response.message || 'Profile updated successfully.');
                        $('.text-danger').text('');
                    },
                    error: function (xhr) {
                        $('#ajaxMessage')
                            .removeClass('d-none alert-success')
                            .addClass('alert alert-danger')
                            .text('Error updating profile.');

                        const response = xhr.responseJSON;
                        if (response && response.errors) {
                            $('.text-danger').text('');

                            for (const field in response.errors) {
                                const messages = response.errors[field];
                                const span = $(`[data-valmsg-for="${field}"]`);
                                if (span.length) {
                                    span.text(messages.join(', '));
                                }
                            }
                        }
                    }
                });
            });
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
