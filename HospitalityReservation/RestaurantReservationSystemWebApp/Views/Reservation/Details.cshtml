@model ReservationViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <h2>Details</h2>
    <dl class="row">
        <dt class="col-sm-3">NumberOfGuests</dt>
        <dd class="col-sm-9">@Model.NumberOfGuests</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">ReservationDate</dt>
        <dd class="col-sm-9">@Model.ReservationDate</dd>
        <dt class="col-sm-3">UserName</dt>
        <dd class="col-sm-9">@Model.UserName</dd>
        <dt class="col-sm-3">VenueName</dt>
        <dd class="col-sm-9">@Model.VenueName</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Idreservation" class="btn btn-outline-primary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>