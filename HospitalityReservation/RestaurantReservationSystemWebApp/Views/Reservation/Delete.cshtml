@model ReservationViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <h2>Delete</h2>
    <h5>Are you sure you want to delete this?</h5>
    <dl class="row">
        <dt class="col-sm-3">NumberOfGuests</dt>
        <dd class="col-sm-9">@Model.NumberOfGuests</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">ReservationDate</dt>
        <dd class="col-sm-9">@Model.ReservationDate</dd>
        <dt class="col-sm-3">UserName</dt>
        <dd class="col-sm-9">@Model.UserName</dd>
        <dt class="col-sm-3">VenueName</dt>
        <dd class="col-sm-9">@Model.VenueName</dd>
    </dl>
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Idreservation">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
</div>